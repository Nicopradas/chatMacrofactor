# --- AI ---
# Anthropic (Claude) API key. REQUIRED. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (Optional) Groq API key to transcribe voice with Whisper. Without it, the
# microphone button is disabled. https://console.groq.com/keys
GROQ_API_KEY=

# --- Storage (image uploads) ---
# Vercel Blob token. REQUIRED to send photos: the browser uploads each image to
# Blob and only its URL is sent to the model, which avoids Vercel's 4.5MB request
# body limit. Create a Blob store in your Vercel project (Storage → Create → Blob);
# it's added automatically there. Locally, run `vercel env pull` to fetch it.
BLOB_READ_WRITE_TOKEN=

# --- App access ---
# (Optional) Password to access the web app. Set it if you host it on a public
# URL. Empty = open app (local use only).
APP_PASSWORD=

# --- Apple Shortcut ---
# (Optional) Only if you rename the shortcut that logs to MacroFactor.
# Defaults to "Log Chat MacroFactor".
NEXT_PUBLIC_MF_SHORTCUT_NAME=
</content>
